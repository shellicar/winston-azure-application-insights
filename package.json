{
  "name": "@shellicar/winston-azure-application-insights",
  "version": "6.0.0",
  "private": false,
  "description": "Azure Application Insights transport for Winston",
  "type": "module",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "demo": "tsx demo.ts",
    "build": "tsup-node",
    "watch": "tsup-node --watch",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "type-check": "tsc -p tsconfig.check.json",
    "ci": "run-s ci:biome ci:type-check",
    "ci:biome": "biome ci --diagnostic-level=error",
    "ci:type-check": "turbo run type-check",
    "ci:fix": "biome check --diagnostic-level=error --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "list-mismatches": "syncpack list-mismatches",
    "fix-mismatches": "syncpack fix-mismatches",
    "updates": "npm-check-updates",
    "postinstall": "lefthook install",
    "verify-version": "./scripts/verify-version.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellicar/winston-azure-application-insights.git"
  },
  "keywords": [
    "winston",
    "azure",
    "insights",
    "logging"
  ],
  "author": "Marco Braga (Bragma)",
  "contributors": [
    {
      "name": "Will Morgan",
      "email": "jobs+npm@willmorgan.co.uk",
      "url": "http://willmorgan.co.uk"
    },
    {
      "name": "Stephen Hellicar",
      "email": "shellicar@gmail.com"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.1.0",
    "@types/triple-beam": "^1.3.5",
    "@vitest/coverage-v8": "^3.2.4",
    "lefthook": "^1.12.2",
    "logform": "^2.7.0",
    "npm-check-updates": "^18.0.2",
    "npm-run-all2": "^8.0.4",
    "syncpack": "^13.0.4",
    "terser": "^5.43.1",
    "testdouble": "^3.20.2",
    "triple-beam": "^1.4.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "optionalDependencies": {
    "applicationinsightsv2": "npm:applicationinsights@^2",
    "applicationinsightsv3": "npm:applicationinsights@^3",
    "applicationinsightsv34": "npm:applicationinsights@^3.4"
  },
  "bugs": {
    "url": "https://github.com/shellicar/winston-azure-application-insights/issues"
  },
  "homepage": "https://github.com/shellicar/winston-azure-application-insights#readme",
  "peerDependencies": {
    "triple-beam": "^1.4.1",
    "winston": "^3.0.0",
    "winston-transport": "^4.0.0"
  }
}
